        android:supportsRtl="true"
        android:theme="@style/Theme.MoYan">
        <activity
            android:name=".ItemCommentActivity"
            android:exported="false" />
        <!-- 启动页 SplashActivity，设置为 LAUNCHER -->
        <activity
