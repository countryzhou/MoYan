<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp"
    android:background="@color/reply_bg">

    <!-- 回复头部：头像和用户名 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivReplyAvatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_avatar_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReplyNickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户名"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 回复目标（显示被回复的人） -->
            <TextView
                android:id="@+id/tvReplyTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="回复 @用户名"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- 回复内容 -->
    <TextView
        android:id="@+id/tvReplyContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="6dp"
        android:text="回复内容"
        android:textColor="@color/text_main"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <!-- 底部操作栏：时间 | 回复 | 点赞 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 回复时间 -->
        <TextView
            android:id="@+id/tvReplyTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="刚刚"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- 回复此回复的按钮 -->
        <TextView
            android:id="@+id/tvReplyToReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="回复"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- 点赞按钮 -->
        <LinearLayout
            android:id="@+id/layoutReplyLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/ivReplyLike"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_like_outline" />

            <TextView
                android:id="@+id/tvReplyLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 删除按钮（单独一行，仅作者可见） -->
    <TextView
        android:id="@+id/tvReplyDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="4dp"
        android:text="删除"
        android:textColor="@color/color_error"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>