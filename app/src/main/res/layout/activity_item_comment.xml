<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/comment_padding_horizontal"
    android:paddingEnd="@dimen/comment_padding_horizontal"
    android:paddingTop="@dimen/comment_padding_vertical"
    android:paddingBottom="@dimen/comment_padding_vertical">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivAvatar"
        android:layout_width="@dimen/avatar_size_comment"
        android:layout_height="@dimen/avatar_size_comment"
        android:src="@drawable/ic_avatar_placeholder" />

    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_xlarge"
        android:layout_toEndOf="@+id/ivAvatar"
        android:text="@string/sample_comment_user"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/post_content_size" />

    <TextView
        android:id="@+id/tvTimeAgo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_xlarge"
        android:layout_toEndOf="@+id/tvUserName"
        android:text="@string/time_ago"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvUserName"
        android:layout_marginStart="@dimen/margin_xlarge"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_toEndOf="@+id/ivAvatar"
        android:lineSpacingExtra="@dimen/post_content_line_spacing"
        android:text="@string/sample_comment_content"
        android:textColor="@color/text_main"
        android:textSize="@dimen/post_content_size" />

    <LinearLayout
        android:id="@+id/likeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivLike"
            android:layout_width="14dp"
            android:layout_height="@dimen/like_icon_size"
            android:src="@drawable/ic_like_outline" />

        <TextView
            android:id="@+id/tvLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:text="0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>